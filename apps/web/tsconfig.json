{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./src/*"],
			"@honeyicons/react": ["../../packages/react/src/index.ts"],
			"@honeyicons/react/catalog": ["../../packages/react/src/catalog.ts"],
			"@honeyicons/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["node_modules", "dist"]
}
