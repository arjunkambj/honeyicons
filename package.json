{
	"name": "honeyicons",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"generate:icons": "node scripts/build-icons.ts",
		"check:icons": "node scripts/check-icons.ts",
		"lint": "oxlint .",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"check": "oxlint --fix . && oxfmt"
	},
	"devDependencies": {
		"@honeyicons/config": "workspace:*",
		"@resvg/resvg-js": "^2.6.2",
		"@types/node": "catalog:",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"turbo": "^2.10.7",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=22.18"
	},
	"packageManager": "pnpm@11.21.0"
}
