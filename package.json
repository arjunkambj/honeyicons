{
	"name": "honeyicons",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"typescript": "^7.0.2",
			"@types/node": "^26.4.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.7",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.5",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"generate:icons": "bun run scripts/build-icons.ts",
		"check": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@honeyicons/config": "workspace:*",
		"@types/node": "catalog:",
		"turbo": "^2.10.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.4.0"
}
