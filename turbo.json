{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"web#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [
				"dist/**",
				".wrangler/deploy/config.json",
				"src/routeTree.gen.ts"
			]
		},
		"web#check-types": {
			"dependsOn": ["^check-types"],
			"outputs": ["src/routeTree.gen.ts"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
