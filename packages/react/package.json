{
	"name": "@honeyicons/react",
	"version": "0.0.7",
	"description": "Carefully crafted SVG icons for React, with TypeScript support.",
	"keywords": [
		"icon-set",
		"icons",
		"react",
		"react-icons",
		"svg",
		"typescript"
	],
	"homepage": "https://github.com/arjunkambj/honeyicons#readme",
	"bugs": "https://github.com/arjunkambj/honeyicons/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arjunkambj/honeyicons.git",
		"directory": "packages/react"
	},
	"files": [
		"dist",
		"icons.json",
		"NOTICE.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./catalog": {
			"types": "./dist/catalog.d.ts",
			"import": "./dist/catalog.js",
			"default": "./dist/catalog.js"
		},
		"./icons.json": "./icons.json",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "rm -rf dist",
		"build": "pnpm run clean && esbuild \"src/**/*.ts\" \"src/**/*.tsx\" --outdir=dist --format=esm --jsx=automatic --target=es2020 --log-level=warning && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"generate": "node ../../scripts/build-icons.ts",
		"check-types": "tsc --noEmit"
	},
	"devDependencies": {
		"@honeyicons/config": "workspace:*",
		"@types/react": "catalog:",
		"esbuild": "^0.28.2",
		"react": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"engines": {
		"node": ">=18"
	}
}
